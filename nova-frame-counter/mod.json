{
  "geode": "5.11.2",
  "gd": {
    "win": "2.2081"
  },
  "id": "zaan.nova-frame-counter",
  "name": "Nova Frame Counter",
  "version": "v0.2.0",
  "developer": "zaan",
  "description": "Input event HUD, press/release markers, simulation tick counter. Frame-window scanning not yet implemented.",
  "settings": {
    "show-counter": {
      "type": "bool",
      "name": "Show frame counter",
      "default": true
    },
    "show-fps": {
      "type": "bool",
      "name": "Show estimated update frequency",
      "default": true
    },
    "counter-scale": {
      "type": "float",
      "name": "Text scale",
      "default": 0.42,
      "min": 0.25,
      "max": 0.9
    },
    "show-markers": {
      "type": "bool",
      "name": "Show input markers",
      "default": true
    },
    "show-ticks": {
      "type": "bool",
      "name": "Show simulation ticks",
      "default": false
    }
  }
}
