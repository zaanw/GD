{
  "geode": "5.11.2",
  "gd": {
    "win": "2.2081"
  },
  "id": "zaan.gd-nova",
  "name": "GD Nova",
  "version": "v0.4.0",
  "developer": "zaan",
  "description": "Experimental evolutionary auto-play bot plus Midnight dashboard and HUD.",
  "settings": {
    "show-hud": {
      "type": "bool",
      "name": "Show HUD",
      "default": true
    },
    "show-attempts": {
      "type": "bool",
      "name": "Show attempts",
      "default": true
    },
    "show-progress": {
      "type": "bool",
      "name": "Show progress",
      "default": true
    },
    "hud-scale": {
      "type": "float",
      "name": "HUD scale",
      "default": 0.45,
      "min": 0.25,
      "max": 0.9
    },
    "bot-enabled": {
      "type": "bool",
      "name": "Experimental Auto Bot",
      "description": "Tries and mutates jump sequences during normal-mode attempts. Not a general level solver.",
      "default": false
    }
  }
}
